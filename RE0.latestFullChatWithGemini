#!/usr/bin/env python3
import sys
import os
import time

try:
    import serial
except ImportError:
    print("[!] Error: missing serial library. Run: apt install python3-serial")
    sys.exit(1)

SERIAL_PORT = "/dev/ttyS0"
BAUD_RATE = 115200

def main():
    print(f"[-] Initializing Key Matrix Decoder on {SERIAL_PORT}...")
    
    try:
        # Open port with a tiny timeout to slice packet boundaries cleanly
        ser = serial.Serial(SERIAL_PORT, baudrate=BAUD_RATE, timeout=0.01)
        ser.flushInput()
    except Exception as e:
        print(f"[!] Driver bind failed: {e}")
        sys.exit(1)

    print("[+] Decoder active. Press various keys to dump their matrix maps...\n")

    try:
        while True:
            # Read an entire transaction block burst from the wire
            packet_chunk = ser.read(32)
            
            if packet_chunk:
                # Filter out the common idle framing blocks (0xC0, 0x40, 0x00, 0xFF)
                # This isolates the core keycode data passing down the line
                filtered_bytes = [b for b in packet_chunk if b not in (0x40, 0xC0, 0x00, 0xFF)]
                
                if filtered_bytes:
                    # Convert the isolated bytes into clean Hex representations
                    hex_string = " ".join(f"0x{b:02X}" for b in filtered_bytes)
                    
                    # Convert to ASCII characters if they fall into standard text ranges
                    ascii_string = "".join(chr(b) if 32 <= b <= 126 else "." for b in filtered_bytes)
                    
                    print(f"[KEY EVENT] Raw Hex: [ {hex_string:<20} ] -> ASCII: '{ascii_string}'")
            else:
                # Prevent CPU core maxing out while waiting for keypresses
                time.sleep(0.005)

    except KeyboardInterrupt:
        print("\n[-] Decoder shut down cleanly.")
    finally:
        ser.close()

if __name__ == "__main__":
    if os.getuid() != 0:
        print("[!] Root privileges required to process hardware serial channels.")
        sys.exit(1)
    main()
