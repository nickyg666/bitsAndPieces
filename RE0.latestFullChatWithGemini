#!/usr/bin/env python3
import os
import sys
import struct

# Replace 'event0' with the specific node found in /proc/bus/input/devices
INPUT_NODE = "/dev/input/event0"

# Linux evdev input_event struct layout binary format:
# 64-bit Seconds, 64-bit Microseconds, 16-bit Type, 16-bit Code, 32-bit Value
EVENT_FORMAT = "QQHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

def main():
    print(f"[-] Hooking into system input device: {INPUT_NODE}")
    
    try:
        fd = os.open(INPUT_NODE, os.O_RDONLY)
    except PermissionError:
        print("[!] Error: Root permissions required to read raw input streams.")
        sys.exit(1)
    except FileNotFoundError:
        print(f"[!] Error: Device node {INPUT_NODE} is offline.")
        sys.exit(1)

    print("[-] Successfully bound listener. Press keys on the keyboard to view frames...\n")

    try:
        while True:
            binary_data = os.read(fd, EVENT_SIZE)
            if not binary_data:
                break
                
            # Unpack the standard Linux input event structure
            sec, usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, binary_data)
            
            # EV_KEY (Type = 1) indicates a physical button event
            if ev_type == 1:
                # ev_value: 0 = Release, 1 = Keypress down, 2 = Continuous repeat
                state = "RELEASE" if ev_value == 0 else "DOWN" if ev_value == 1 else "REPEAT"
                
                print(f"[+] Key Event Captured - Code: {ev_code} | Action: {state} | Timestamp: {sec}.{usec:06d}")

    except KeyboardInterrupt:
        print("\n[-] Listener closed cleanly.")
    finally:
        os.close(fd)

if __name__ == "__main__":
    main()
