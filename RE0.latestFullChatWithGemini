#!/usr/bin/env python3
import sys
import os
import time

try:
    import serial
except ImportError:
    print("[!] Error: Missing serial module. Run: apt install python3-serial")
    sys.exit(1)

# Target the dedicated UART0 console port via you tapped into
SERIAL_PORT = "/dev/ttyS0"

def parse_touch_payload(data_bytes):
    """Decodes the high-speed 1.5M absolute tracking coordinate packet."""
    hex_string = " ".join(f"0x{b:02X}" for b in data_bytes)
    print(f"[TOUCHPAD MULTI-TOUCH BURST]: {hex_string}")

def parse_keyboard_payload(data_bytes):
    """Decodes the lower-speed discrete keyboard matrix character frames."""
    hex_string = " ".join(f"0x{b:02X}" for b in data_bytes)
    print(f"[KEYBOARD MATRIX SCANCODE]:  {hex_string}")

def main():
    print(f"[-] Initializing dynamic multi-mode serial tracker on {SERIAL_PORT}...")
    
    current_baud = 1500000
    ser = serial.Serial(SERIAL_PORT, baudrate=current_baud, timeout=0.05)
    ser.flushInput()
    
    print(f"[-] Default hardware state set: Monitoring Touchpad at {current_baud} Baud.")
    print("[-] Tap the touchpad or hit keys... Press Ctrl+C to stop.\n")

    try:
        while True:
            # Attempt a standard read loop chunk execution
            # Touchpad bursts typically fire in quick 6-byte or 8-byte payload clusters
            buffer = ser.read(8)
            
            if buffer:
                # If we are in 1.5M mode and receiving data that isn't idle padding
                if current_baud == 1500000:
                    if any(b != 0x00 and b != 0xFF for b in buffer):
                        parse_touch_payload(buffer)
                else:
                    # We are in low-speed keyboard decoding mode
                    if any(b != 0x00 and b != 0xFF for b in buffer):
                        parse_keyboard_payload(buffer)
            else:
                # If the line goes completely silent (timeout), check for mode transitions
                # If we were tracking a touch event but the user stopped, cycle checking modes
                pass

            # ---- DYNAMIC BAUD BAILOUT DETECTOR ----
            # If the user is hammering a keyboard key, 1.5M reads it as a framing error or corrupt text.
            # We can sample the character buffers to test if we need to down-step the serial clock.
            if current_baud == 1500000 and any(b == 0x40 or b == 0x00 for b in buffer) and len(buffer) > 0:
                # Close the port, recalculate clock dividers, and switch to character mode
                ser.close()
                current_baud = 115200 # Set to your verified keyboard speed
                ser = serial.Serial(SERIAL_PORT, baudrate=current_baud, timeout=0.2)
                print(f"\n[!] State Switch: Down-sampling clock to {current_baud} Baud for Keyboard Core...")
                ser.flushInput()
                
            elif current_baud != 1500000 and len(buffer) == 0:
                # If the keyboard stops sending keys for a short window, switch back to high-speed touchpad monitoring
                ser.close()
                current_baud = 1500000
                ser = serial.Serial(SERIAL_PORT, baudrate=current_baud, timeout=0.05)
                print(f"\n[!] State Switch: Re-aligning clock to {current_baud} Baud for Touchpad Core...")
                ser.flushInput()

    except KeyboardInterrupt:
        print("\n[-] Dynamic sniffer terminated by user.")
    finally:
        if ser.isOpen():
            ser.close()

if __name__ == "__main__":
    if os.getuid() != 0:
        print("[!] Root access required to map hardware serial peripherals.")
        sys.exit(1)
    main()
