    if (mem_fd < 0) return 1;

    void *page_map = mmap(NULL, MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, mem_fd, GPIO_PAGE_BASE);
    close(mem_fd);
    if (page_map == MAP_FAILED) return 1;

    void *pio_base = (char *)page_map + PIO_OFFSET;
    volatile uint32_t *pc_cfg0 = (volatile uint32_t *)((char *)pio_base + PIO_C_CFG0);
    volatile uint32_t *pc_data = (volatile uint32_t *)((char *)pio_base + PIO_C_DATA);

    // Lock pins as inputs
    *pc_cfg0 &= ~(0xF00);  
    *pc_cfg0 &= ~(0x0F0);  

    printf("[-] Sniffer tuned to packet mode. Matrix listening active...\n");

    uint32_t last_clk = (*pc_data >> 2) & 1;
    uint8_t bit_counter = 0;
    uint8_t current_byte = 0;
    
    uint8_t packet_buffer[8]; // Standard 8-byte USB HID keyboard frame report buffer
    uint8_t byte_idx = 0;
    
    uint32_t idle_timeout = 0;

    while (1) {
        uint32_t reg_snapshot = *pc_data;
        uint32_t current_clk = (reg_snapshot >> 2) & 1;

        // Software Rising Edge Sync
        if (last_clk == 0 && current_clk == 1) {
            uint32_t bit_val = (reg_snapshot >> 1) & 1;
            current_byte = (current_byte << 1) | bit_val;
            bit_counter++;
            idle_timeout = 0; // Reset active frame timer

            if (bit_counter == 8) {
                if (byte_idx < 8) {
                    packet_buffer[byte_idx++] = current_byte;
                }
                bit_counter = 0;
                current_byte = 0;
            }
        }
        
        last_clk = current_clk;
        idle_timeout++;

        // If the clock stops pulsing for a brief duration, we have hit a bus turnaround boundary
        if (idle_timeout > 500000 && byte_idx > 0) {
            // Process the collected transaction burst if it contains non-trivial data
            // Legitimate key reports don't fill out as pure 0x00 or 0xFF padding
            int valid_payload = 0;
            for (int i = 0; i < byte_idx; i++) {
                if (packet_buffer[i] != 0x00 && packet_buffer[i] != 0xFF) {
                    valid_payload = 1;
                    break;
                }
            }

            if (valid_payload) {
                printf("[+] Packet Frame (%d Bytes): ", byte_idx);
                for (int i = 0; i < byte_idx; i++) {
                    printf("0x%02X ", packet_buffer[i]);
                }
                printf("\n");
            }

            // Flush indexers back to baseline to track the next transaction sweep
            byte_idx = 0;
            bit_counter = 0;
            idle_timeout = 0;
        }
    }

    munmap(page_map, MAP_SIZE);
    return 0;
}
