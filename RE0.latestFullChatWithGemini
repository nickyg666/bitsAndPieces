#define _POSIX_C_SOURCE 199309L
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <time.h>
#include <unistd.h>

#define GPIO_PAGE_BASE   0x01C20000 
#define MAP_SIZE         4096
#define PIO_OFFSET       0x800

#define PIO_A_CFG0       0x00  // Configures pins PA0-PA7
#define PIO_A_DATA       0x10  // Port A data register

int main() {
    int mem_fd = open("/dev/mem", O_RDWR | O_SYNC);
    if (mem_fd < 0) {
        perror("[!] Run as root via sudo");
        return 1;
    }

    void *page_map = mmap(NULL, MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, mem_fd, GPIO_PAGE_BASE);
    close(mem_fd);
    if (page_map == MAP_FAILED) return 1;

    void *pio_base = (char *)page_map + PIO_OFFSET;
    volatile uint32_t *pa_cfg0 = (volatile uint32_t *)((char *)pio_base + PIO_A_CFG0);
    volatile uint32_t *pa_data = (volatile uint32_t *)((char *)pio_base + PIO_A_DATA);

    // ---- INITIALIZATION PHASE: INTER-CHIP WAKEUP ----
    // Configure PA1 (Clock) and PA2 (Data) as OUTPUTS (Mode 001) to send the wake-up token
    uint32_t cfg = *pa_cfg0;
    cfg &= ~(0x00000FFF); // Clear configs for PA1 and PA2
    cfg |=  (0x00000110); // Set both PA1 and PA2 to Output mode
    *pa_cfg0 = cfg;

    printf("[-] Sending synthetic wakeup token to the auxiliary MCU...\n");

    // Replicate the RF master's handshake: Hold Clock Low and pulse Data High
    *pa_data &= ~(1 << 1); // Clock LOW
    for (int i = 0; i < 10; i++) {
        *pa_data |= (1 << 2);  // Data HIGH
        usleep(500);
        *pa_data &= ~(1 << 2); // Data LOW
        usleep(500);
    }

    // ---- MONITORING PHASE: TRANSITION TO LISTENER ----
    // Flip PA1 (Clock) to INPUT (Mode 000) to listen for the auxiliary MCU's clock pulses
    // Flip PA2 (Data) to INPUT (Mode 000) to safely read the incoming data stream
    cfg = *pa_cfg0;
    cfg &= ~(0x00000FFF); // Set both pins back to high-impedance Input mode
    *pa_cfg0 = cfg;

    printf("[+] Wakeup sequence complete. Listening for data streams...\n\n");

    uint32_t last_clk = (*pa_data >> 1) & 1;
    uint8_t current_byte = 0;
    uint8_t bit_counter = 0;

    while (1) {
        uint32_t reg_snapshot = *pa_data;
        uint32_t current_clk = (reg_snapshot >> 1) & 1;
        uint32_t current_dat = (reg_snapshot >> 2) & 1;

        // Sample data on the rising edge of the auxiliary chip's clock
        if (last_clk == 0 && current_clk == 1) {
            current_byte = (current_byte << 1) | current_dat;
            bit_counter++;

            if (bit_counter == 8) {
                if (current_byte != 0x00 && current_byte != 0xFF) {
                    printf("0x%02X ", current_byte);
                    fflush(stdout);
                }
                bit_counter = 0;
                current_byte = 0;
            }
        }
        last_clk = current_clk;
    }

    munmap(page_map, MAP_SIZE);
    return 0;
}
