c
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <unistd.h>

#define GPIO_PAGE_BASE   0x01C20000 
#define MAP_SIZE         4096
#define PIO_OFFSET       0x800

#define PIO_C_CFG0       0x48  // Pin function configurations for PC0-PC7
#define PIO_C_DATA       0x5C  // Port C raw state values register

int main() {
    int mem_fd = open("/dev/mem", O_RDWR | O_SYNC);
    if (mem_fd < 0) {
        perror("[!] Root privileges or /dev/mem access required");
        return 1;
    }

    void *page_map = mmap(NULL, MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, mem_fd, GPIO_PAGE_BASE);
    close(mem_fd);
    if (page_map == MAP_FAILED) {
        perror("[!] Memory mapping failure");
        return 1;
    }

    void *pio_base = (char *)page_map + PIO_OFFSET;
    volatile uint32_t *pc_cfg0 = (volatile uint32_t *)((char *)pio_base + PIO_C_CFG0);
    volatile uint32_t *pc_data = (volatile uint32_t *)((char *)pio_base + PIO_C_DATA);

    printf("[-] Current CFG0 Register State before override: 0x%08X\n", *pc_cfg0);

    // Hard Override: Disconnect kernel hardware SPI blocks from the traces
    // PC2 is bits 11:8, PC1 is bits 7:4. 
    // We clear these blocks to 0000 to force standard GPIO Input function.
    uint32_t cfg_mask = *pc_cfg0;
    cfg_mask &= ~(0x00000F00); // Clear PC2 configuration block
    cfg_mask &= ~(0x000000F0); // Clear PC1 configuration block
    *pc_cfg0 = cfg_mask;       // Write the updated configuration to the CPU registers

    printf("[-] Applied manual multiplexer override. CFG0: 0x%08X\n", *pc_cfg0);
    printf("[-] Listening for raw hardware wire flips...\n\n");

    uint32_t last_reg = *pc_data;
    uint32_t last_clk = (last_reg >> 2) & 1;
    uint32_t last_dat = (last_reg >> 1) & 1;
    uint64_t loop_counter = 0;

    while (1) {
        uint32_t reg_snapshot = *pc_data;
        uint32_t current_clk = (reg_snapshot >> 2) & 1;
        uint32_t current_dat = (reg_snapshot >> 1) & 1;

        // Flash an immediate notification if any wire levels shift
        if (current_clk != last_clk || current_dat != last_dat) {
            printf("[CRITICAL CHANGE] -> SCLK (PC2): %d | DATA (PC1): %d [Clock Cycle #%lu]\n", 
                   current_clk, current_dat, loop_counter);
            fflush(stdout);
            
            last_clk = current_clk;
            last_dat = current_dat;
        }

        loop_counter++;

        if (loop_counter % 50000000 == 0) {
            printf("[Heartbeat] Raw Data Reg: 0x%08X | SCLK: %d | DATA: %d\n", 
                   reg_snapshot, current_clk, current_dat);
            fflush(stdout);
        }
    }

    munmap(page_map, MAP_SIZE);
    return 0;
}
